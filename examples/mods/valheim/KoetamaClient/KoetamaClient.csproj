<Project Sdk="Microsoft.NET.Sdk">
  <!-- The reference client for C# games (Unity/Mono included): no dependencies. netstandard2.0 for any game; also
       built for net462, so a Unity game whose scripts use the .NET Framework profile (Valheim's do) needs no
       netstandard facade at all. -->
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net462</TargetFrameworks>
    <LangVersion>9.0</LangVersion>
    <RootNamespace>Koetama</RootNamespace>
    <AssemblyName>KoetamaClient</AssemblyName>
    <Version>0.1.0</Version>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="KoetamaClient.Tests" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net462'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
